{
  "ConnectionStrings": {
    "ECafeDb": "Host=localhost;Port=5433;Database=ECafe;Username=ecafe_user;Password=YOUR_LOCAL_PASSWORD"
  },
  "Sentry": {
    "Dsn": "",
    "Debug": false,
    "EnableLogs": false,
    "TracesSampleRate": 0.1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "ecafefiles",
    "UseSSL": false
  },
  "FileStorage": {
    "PublicBaseUrl": "http://localhost:8080"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "ecafe",
    "Audience": "ecafe-users"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "Username": "",
    "Password": "",
    "From": "",
    "FromName": "E-Cafe Admin"
  },
  "EmailOutbox": {
    "IntervalSeconds": 15,
    "BatchSize": 50,
    "LockSeconds": 300,
    "MaxRetryCount": 5
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "FailedAttemptWindowMinutes": 15,
    "LockoutMinutes": 15,
    "NotifyOnLockout": true
  },
  "RateLimiting": {
    "AuthLogin": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "AuthRefresh": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "FileUpload": {
      "PermitLimit": 20,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "FileDownload": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "PublicRead": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "AllowedHosts": "*"

}
