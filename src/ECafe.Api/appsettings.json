{
  "ConnectionStrings": {
    "ECafeDb": ""
  },
  "Sentry": {
    "Dsn": "",
    "Debug": false,
    "EnableLogs": false,
    "TracesSampleRate": 0.1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MinIO": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "ecafefiles",
    "UseSSL": false
  },
  "FileStorage": {
    "PublicBaseUrl": ""
  },
  "ImageProcessing": {
    "Enabled": true,
    "MaxWidth": 1440,
    "MaxHeight": 1440,
    "WebpQuality": 82,
    "OutputFormat": "webp",
    "OptimizedFileTypeCodes": "RestaurantImage,MenuItemImage,UserProfileImage,TemporaryUpload"
  },
  "Geocoding": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "ECafe/1.0",
    "TimeoutSeconds": 10,
    "CacheMinutes": 1440,
    "CountryCodes": "az"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "ecafe",
    "Audience": "ecafe-users",
    "AccessTokenLifetimeMinutes": 15
  },
  "Email": {
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": "587",
    "Username": "",
    "Password": "",
    "From": "",
    "FromName": "ECafe",
    "SecureSocketOption": "StartTls",
    "TimeoutSeconds": 30,
    "LocalDomain": "localhost"
  },
  "Sms": {
    "Enabled": false,
    "Provider": "Fake",
    "BaseUrl": "https://1sms.az/api/v1",
    "ApiKey": "",
    "ApiKeyHeader": "X-API-Key",
    "Sender": "1sms.az"
  },
  "EmailOutbox": {
    "IntervalSeconds": 15,
    "BatchSize": 50,
    "LockSeconds": 300,
    "MaxRetryCount": 5
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "FailedAttemptWindowMinutes": 15,
    "LockoutMinutes": 15,
    "NotifyOnLockout": true
  },
  "RateLimiting": {
    "AuthLogin": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "AuthRefresh": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "AuthPasswordReset": {
      "PermitLimit": 3,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "FileUpload": {
      "PermitLimit": 20,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "FileDownload": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "PublicRead": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Redis": {
    "Connection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": ""
  },
  "AllowedHosts": "*"

}
