{
  "ConnectionStrings": {
    "ECafeDb": "Host=localhost;Port=5433;Database=ECafe;Username=ecafe_user;Password=YOUR_LOCAL_PASSWORD"
  },
  "Sentry": {
    "Dsn": "YOUR_SENTRY_DSN",
    "Debug": false,
    "EnableLogs": false,
    "TracesSampleRate": 0.1
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "YOUR_MINIO_ACCESS_KEY",
    "SecretKey": "YOUR_MINIO_SECRET_KEY",
    "BucketName": "ecafefiles",
    "UseSSL": false
  },
  "Jwt": {
    "Key": "YOUR_LONG_RANDOM_LOCAL_JWT_KEY",
    "Issuer": "ecafe",
    "Audience": "ecafe-users"
  },
  "Email": {
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": "587",
    "Username": "YOUR_BREVO_SMTP_LOGIN",
    "Password": "YOUR_BREVO_SMTP_KEY",
    "From": "YOUR_VERIFIED_SENDER_EMAIL",
    "FromName": "ECafe",
    "SecureSocketOption": "StartTls",
    "TimeoutSeconds": 30,
    "LocalDomain": "localhost"
  },
  "Sms": {
    "Enabled": false,
    "Provider": "Fake",
    "BaseUrl": "https://1sms.az/api/v1",
    "ApiKey": "YOUR_1SMS_API_KEY",
    "Sender": "1sms.az"
  },
  "EmailOutbox": {
    "IntervalSeconds": 15,
    "BatchSize": 50,
    "LockSeconds": 300,
    "MaxRetryCount": 5
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "FailedAttemptWindowMinutes": 15,
    "LockoutMinutes": 15,
    "NotifyOnLockout": true
  },
  "RateLimiting": {
    "AuthLogin": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "AuthRefresh": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "AuthPasswordReset": {
      "PermitLimit": 3,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "FileUpload": {
      "PermitLimit": 20,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "FileDownload": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "PublicRead": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.ecafe.example"
    ]
  },
  "ForwardedHeaders": {
    "KnownProxies": [
      "10.0.0.10"
    ]
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
  },
  "AllowedHosts": "*"
}
