{
  "ConnectionStrings": {
    "ECafeDb": "Host=localhost;Port=5433;Database=ECafe;Username=ecafe_user;Password=CHANGE_ME_LOCAL_DB_PASSWORD"
  },
  "Sentry": {
    "Dsn": "",
    "Debug": false,
    "EnableLogs": false,
    "TracesSampleRate": 0.1
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "CHANGE_ME_MINIO_ACCESS_KEY",
    "SecretKey": "CHANGE_ME_MINIO_SECRET_KEY",
    "BucketName": "ecafefiles",
    "UseSSL": false
  },
  "FileStorage": {
    "PublicBaseUrl": "http://localhost:8080"
  },
  "Jwt": {
    "Key": "CHANGE_ME_LONG_RANDOM_LOCAL_JWT_KEY_32_CHARS_MINIMUM",
    "Issuer": "ecafe",
    "Audience": "ecafe-users",
    "AccessTokenLifetimeMinutes": 15
  },
  "Email": {
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": "587",
    "Username": "CHANGE_ME_BREVO_SMTP_LOGIN",
    "Password": "CHANGE_ME_BREVO_SMTP_KEY",
    "From": "CHANGE_ME_VERIFIED_SENDER_EMAIL",
    "FromName": "ECafe",
    "SecureSocketOption": "StartTls",
    "TimeoutSeconds": 30,
    "LocalDomain": "localhost"
  },
  "Sms": {
    "Enabled": false,
    "Provider": "Fake",
    "BaseUrl": "https://1sms.az/api/v1",
    "ApiKey": "CHANGE_ME_1SMS_API_KEY",
    "ApiKeyHeader": "X-API-Key",
    "Sender": "1sms.az"
  },
  "EmailOutbox": {
    "IntervalSeconds": 15,
    "BatchSize": 50,
    "LockSeconds": 300,
    "MaxRetryCount": 5
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "FailedAttemptWindowMinutes": 15,
    "LockoutMinutes": 15,
    "NotifyOnLockout": true
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "SignalR": {
    "UseRedisBackplane": false,
    "Redis": {
      "Connection": "localhost:6379"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:8081",
      "http://127.0.0.1:8081"
    ]
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": ""
  },
  "AllowedHosts": "*"
}
