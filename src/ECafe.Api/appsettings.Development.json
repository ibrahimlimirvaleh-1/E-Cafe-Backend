{
  "ConnectionStrings": {
    "ECafeDb": "Host=localhost;Port=5433;Database=ECafe;Username=ecafe_user;Password=replace-with-local-db-password"
  },
  "Sentry": {
    "Dsn": "",
    "Debug": false,
    "EnableLogs": false,
    "TracesSampleRate": 0.1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "replace-with-local-minio-password",
    "BucketName": "ecafefiles",
    "UseSSL": false
  },
  "FileStorage": {
    "PublicBaseUrl": "http://localhost:8080"
  },
  "ImageProcessing": {
    "Enabled": true,
    "MaxWidth": 1440,
    "MaxHeight": 1440,
    "WebpQuality": 82,
    "OutputFormat": "webp",
    "OptimizedFileTypeCodes": "RestaurantImage,MenuItemImage,UserProfileImage,TemporaryUpload"
  },
  "Geocoding": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "ECafe-Dev/1.0",
    "TimeoutSeconds": 10,
    "CacheMinutes": 1440,
    "CountryCodes": "az"
  },

  "Jwt": {
    "Key": "replace-with-long-random-jwt-key",
    "Issuer": "ecafe",
    "Audience": "ecafe-users",
    "AccessTokenLifetimeMinutes": 15
  },
  "Email": {
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": "587",
    "Username": "",
    "Password": "",
    "From": "",
    "FromName": "ECafe",
    "SecureSocketOption": "StartTls",
    "TimeoutSeconds": 30,
    "LocalDomain": "localhost"
  },
  "Sms": {
    "Enabled": false,
    "Provider": "Fake",
    "BaseUrl": "https://1sms.az/api/v1",
    "ApiKey": "",
    "ApiKeyHeader": "X-API-Key",
    "Sender": "1sms.az"
  },
  "EmailOutbox": {
    "IntervalSeconds": 15,
    "BatchSize": 50,
    "LockSeconds": 300,
    "MaxRetryCount": 5
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "FailedAttemptWindowMinutes": 15,
    "LockoutMinutes": 15,
    "NotifyOnLockout": true
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "SignalR": {
    "UseRedisBackplane": false,
    "Redis": {
      "Connection": "localhost:6379"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:8081",
      "http://127.0.0.1:8081"
    ]
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": ""
  },
  "AllowedHosts": "*"
}
