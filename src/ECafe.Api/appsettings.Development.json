{
  "ConnectionStrings": {
    "ECafeDb": "Host=localhost;Port=5433;Database=ECafe;Username=ecafe_user;Password=replace-with-local-db-password"
  },
  "Sentry": {
    "Dsn": "",
    "Debug": false,
    "EnableLogs": false,
    "TracesSampleRate": 0.1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "replace-with-local-minio-password",
    "BucketName": "ecafefiles",
    "UseSSL": false
  },
  "FileStorage": {
    "PublicBaseUrl": "http://localhost:8080"
  },

  "Jwt": {
    "Key": "replace-with-long-random-jwt-key",
    "Issuer": "ecafe",
    "Audience": "ecafe-users",
    "AccessTokenLifetimeMinutes": 15
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "Username": "",
    "Password": "",
    "From": "",
    "FromName": "E-Cafe Admin"
  },
  "EmailOutbox": {
    "IntervalSeconds": 15,
    "BatchSize": 50,
    "LockSeconds": 300,
    "MaxRetryCount": 5
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "FailedAttemptWindowMinutes": 15,
    "LockoutMinutes": 15,
    "NotifyOnLockout": true
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "AllowedHosts": "*"
}
