ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

AllowedHosts=api.ecafe.example
ConnectionStrings__ECafeDb=Host=prod-db;Port=5432;Database=ECafe;Username=ecafe_app;Password=SET_FROM_SECRET_MANAGER

Jwt__Key=SET_FROM_SECRET_MANAGER_LONG_RANDOM_KEY
Jwt__Issuer=ecafe
Jwt__Audience=ecafe-users
Jwt__AccessTokenLifetimeMinutes=10
Authentication__RefreshTokenCookieDays=7

Cors__AllowedOrigins__0=https://admin.ecafe.example
Cors__AllowedOrigins__1=https://ecafe.example
ForwardedHeaders__KnownProxies__0=10.0.0.10

Redis__Connection=prod-redis:6379,password=SET_FROM_SECRET_MANAGER,ssl=True,abortConnect=False
SignalR__UseRedisBackplane=true
SignalR__Redis__Connection=prod-redis:6379,password=SET_FROM_SECRET_MANAGER,ssl=True,abortConnect=False

MinIO__Endpoint=s3-or-minio.ecafe.example
MinIO__AccessKey=SET_FROM_SECRET_MANAGER
MinIO__SecretKey=SET_FROM_SECRET_MANAGER
MinIO__BucketName=ecafefiles
MinIO__UseSSL=true
FileStorage__PublicBaseUrl=https://api.ecafe.example

Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=587
Email__Username=SET_FROM_SECRET_MANAGER
Email__Password=SET_FROM_SECRET_MANAGER
Email__From=noreply@ecafe.example
Email__FromName=ECafe
Email__SecureSocketOption=StartTls
Email__TimeoutSeconds=30
Email__LocalDomain=ecafe.example

Sms__Enabled=false
Sms__Provider=Fake
Sms__BaseUrl=https://1sms.az/api/v1
Sms__ApiKey=SET_FROM_SECRET_MANAGER
Sms__ApiKeyHeader=X-API-Key
Sms__Sender=1sms.az

Sentry__Dsn=SET_FROM_SECRET_MANAGER
Sentry__Debug=false
Sentry__EnableLogs=true
Sentry__TracesSampleRate=0.05
