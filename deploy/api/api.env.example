ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
DataProtection__KeyRingPath=/var/lib/ecafe/data-protection-keys

AllowedHosts=api.ecafe.example
ConnectionStrings__ECafeDb=Host=prod-db;Port=5432;Database=ECafe;Username=ecafe_app;Password=SET_FROM_SECRET_MANAGER

Jwt__Key=SET_FROM_SECRET_MANAGER_LONG_RANDOM_KEY
Jwt__Issuer=ecafe
Jwt__Audience=ecafe-users
Jwt__AccessTokenLifetimeMinutes=10
Authentication__RefreshTokenCookieDays=7

Cors__AllowedOrigins__0=https://admin.ecafe.example
Cors__AllowedOrigins__1=https://ecafe.example
ForwardedHeaders__KnownProxies__0=10.0.0.10

Redis__Connection=prod-redis:6379,password=SET_FROM_SECRET_MANAGER,ssl=True,abortConnect=False
SignalR__UseRedisBackplane=true
SignalR__Redis__Connection=prod-redis:6379,password=SET_FROM_SECRET_MANAGER,ssl=True,abortConnect=False

MinIO__Endpoint=s3-or-minio.ecafe.example
MinIO__AccessKey=SET_FROM_SECRET_MANAGER
MinIO__SecretKey=SET_FROM_SECRET_MANAGER
MinIO__BucketName=ecafefiles
MinIO__UseSSL=true
FileStorage__PublicBaseUrl=https://api.ecafe.example
ImageProcessing__Enabled=true
ImageProcessing__MaxWidth=1440
ImageProcessing__MaxHeight=1440
ImageProcessing__WebpQuality=82
ImageProcessing__OutputFormat=webp
ImageProcessing__OptimizedFileTypeCodes=RestaurantImage,MenuItemImage,UserProfileImage,TemporaryUpload

Geocoding__Provider=Geoapify
Geocoding__BaseUrl=https://api.geoapify.com
Geocoding__ApiKey=SET_FROM_SECRET_MANAGER
Geocoding__Language=az
Geocoding__Bias=proximity:49.8671,40.4093
Geocoding__TimeoutSeconds=10
Geocoding__CacheMinutes=1440
Geocoding__CountryCodes=az

Reservations__HoldMinutes=15
Reservations__ExpiryWorkerIntervalSeconds=60
Reservations__DefaultDurationMinutes=180

Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=587
Email__Username=SET_FROM_SECRET_MANAGER
Email__Password=SET_FROM_SECRET_MANAGER
Email__From=noreply@ecafe.example
Email__FromName=ECafe
Email__SecureSocketOption=StartTls
Email__TimeoutSeconds=30
Email__LocalDomain=ecafe.example

# Enable only after a signed app and physical-device push delivery are verified.
MobileApp__PushDeliveryReady=false
MobileApp__ExpoProjectId=db71d0d5-bde7-47f0-8e84-95475e07588c
MobileApp__ExpoAccessToken=SET_FROM_SECRET_MANAGER
MobileApp__WorkerIntervalSeconds=15
MobileApp__WorkerBatchSize=50
MobileApp__Release__Ready=false
MobileApp__Release__ApkPath=/var/lib/ecafe/private-releases/ECafe.apk
MobileApp__Release__Version=
MobileApp__Release__VersionCode=0
MobileApp__Release__SizeBytes=0
MobileApp__Release__Sha256=

Sentry__Dsn=SET_FROM_SECRET_MANAGER
Sentry__Debug=false
Sentry__EnableLogs=true
Sentry__TracesSampleRate=0.05
